{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shuyun-zhihu-learning",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shuyun-learning",
      "database_id": "3207ec0b-0220-4c88-bf59-1f61be1c3347",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
